QCheckBox {
    background-color: transparent;
    margin: 0;
    border: 0;
    padding: 0;
}

QCheckBox:focus {
    background-color: transparent;
    margin: 0;
    border: 0;
    padding: 0;
}

QCheckBox::indicator {
    background-color: transparent;
    width: 2.4ex;
    height: 2.4ex;
}

QCheckBox::indicator:focus,
QCheckBox::indicator:hover {
    background-color: transparent;
    border: none;
}

QCheckBox::indicator:checked {
    image: {{ icon('check_box_checked_accent') }};
}

QCheckBox::indicator:unchecked {
    image: {{ icon('check_box_unchecked_muted') }};
}

QCheckBox::indicator:checked:disabled {
    image: {{ icon('check_box_checked_muted') }};
}

QCheckBox::indicator:unchecked:disabled {
    image: {{ icon('check_box_unchecked_muted') }};
}

QCheckBox::indicator:unchecked:hover {
    image: {{ icon('check_box_unchecked_accent') }};
}
