QMenuBar {
    background-color: palette(base);
    border: none;
    border-bottom: 1px solid {{ soft_border }};
    spacing: 0.3ex;
}

QMenuBar::item {
    padding: 0.6ex 1.2ex;
    margin: 0.3ex 0.1ex;
    background: transparent;
    border-radius: {{ radius }};
}

QMenuBar::item:selected {
    background: {{ palette('highlight') | alpha(25) }};
}

QMenuBar::item:pressed {
    background: {{ palette('highlight') | alpha(50) }};
}

QMenu {
    background-color: palette(base);
    border: 1px solid {{ soft_border }};
    border-radius: {{ radius }};
    padding: 0.5ex 0;
}

QMenu::item {
    padding: 0.8ex 3ex 0.8ex 1.4ex;
    margin: 0 0.5ex;
    border-radius: {{ radius_small }};
}

QMenu::item:selected {
    background: {{ palette('highlight') | alpha(25) }};
}

QMenu::separator {
    height: 1px;
    background: {{ soft_border }};
    margin: 0.4ex 0.8ex;
}
