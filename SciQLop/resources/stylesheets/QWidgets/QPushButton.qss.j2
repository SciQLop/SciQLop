
QPushButton {
    background-color: {{ control_bg }};
    border: 1px solid {{ soft_border }};
    border-radius: {{ radius }};
    height: {{ controls_height }};
    padding: 0 1.6ex;
}


QPushButton:disabled {
    color: {{ palette('UnselectedText') }};
    background-color: palette(window);
    border: 1px solid {{ soft_border | over(palette('base'), 128) }};
}

QPushButton:enabled:hover {
    background-color: {{ palette('highlight') | over(control_bg, 36) }};
    border: 1px solid {{ palette('Selection') | over(palette('base'), 150) }};
}

QPushButton:enabled:focus {
    border: 1px solid {{ palette('Selection') }};
}

QPushButton:enabled:pressed,
QPushButton:enabled:pressed:focus {
    background-color: {{ palette('highlight') | over(control_bg, 70) }};
    border: 1px solid {{ palette('Selection') }};
}

QPushButton:enabled:default {
    background-color: {{ palette('highlight') }};
    color: palette(highlighted-text);
    border: 1px solid {{ palette('highlight') }};
}

QPushButton:enabled:default:hover {
    background-color: {{ palette('highlight') | lighter(112) }};
}

/* Icon-like buttons of a toolbar: flat until the mouse is over them. Last, to win over the rules above. */
QPushButton[compact="true"] {
    padding: 0;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton[compact="true"]:enabled:hover {
    background-color: {{ hover_bg }};
    border: 1px solid transparent;
}

QPushButton[compact="true"]:enabled:pressed {
    background-color: {{ unfocused_selected_bg }};
    border: 1px solid transparent;
}
