QDoubleSpinBox,
QSpinBox {
    background-color: palette(base);
    margin: 0;
    border: 1px solid {{ soft_border }};
    border-radius: {{ radius }};
    padding: 0 0 0 {{ text_inset }};
    height: {{ controls_height }};
}

QDoubleSpinBox:enabled:hover,
QSpinBox:enabled:hover {
    border: 1px solid {{ palette('Selection') | over(palette('base'), 150) }};
}

QDoubleSpinBox:focus,
QSpinBox:focus {
    border: 1px solid {{ palette('Selection') }};
}

QDoubleSpinBox:disabled,
QSpinBox:disabled {
    background-color: palette(window);
    border: 1px solid {{ soft_border | over(palette('base'), 128) }};
}

/* The arrow is its own sub-control. As an image on the button, Qt still drew its native arrow under it,
   and the two halves came out at different sizes. */
QDateTimeEdit::up-button,
QDateEdit::up-button,
QTimeEdit::up-button,
QDoubleSpinBox::up-button,
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 3ex;
    border: none;
    background: transparent;
    margin: 1px 1px 0 0;
    padding-top: 0.3ex;
    border-top-right-radius: {{ radius }};
}

QDateTimeEdit::down-button,
QDateEdit::down-button,
QTimeEdit::down-button,
QDoubleSpinBox::down-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 3ex;
    border: none;
    background: transparent;
    margin: 0 1px 1px 0;
    padding-bottom: 0.3ex;
    border-bottom-right-radius: {{ radius }};
}

QDateTimeEdit::up-button:hover,
QDateEdit::up-button:hover,
QTimeEdit::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::up-button:hover,
QDateTimeEdit::down-button:hover,
QDateEdit::down-button:hover,
QTimeEdit::down-button:hover,
QDoubleSpinBox::down-button:hover,
QSpinBox::down-button:hover {
    background: {{ hover_bg }};
}

QDateTimeEdit::up-arrow,
QDateEdit::up-arrow,
QTimeEdit::up-arrow,
QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow {
    image: {{ icon('arrow_drop_up_tight') }};
    width: 1.6ex;
    height: 0.8ex;
}

QDateTimeEdit::down-arrow,
QDateEdit::down-arrow,
QTimeEdit::down-arrow,
QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow {
    image: {{ icon('arrow_drop_down_tight') }};
    width: 1.6ex;
    height: 0.8ex;
    margin: 0;  /* the combo box rules, shared by date fields, shift this arrow for their drop-down */
}
