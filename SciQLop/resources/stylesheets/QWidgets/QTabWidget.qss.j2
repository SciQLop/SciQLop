QTabWidget::pane {
    border-top: 1px solid {{ soft_border }};
}

QTabWidget::tab-bar {
    left: 1ex;
}

/* Only the underline tells the current tab: a filled tab reads as a box on a window-coloured bar. */
QTabBar::tab {
    background: transparent;
    min-width: 8ex;
    padding: 0.9ex 1.6ex;
    margin: 0 0.2ex;
    border: none;
    border-bottom: 0.35ex solid transparent;
}

QTabBar::tab:!selected {
    color: {{ palette('UnselectedText') }};
}

QTabBar::tab:hover:!selected {
    color: palette(text);
    border-bottom: 0.35ex solid {{ soft_border }};
}

QTabBar::tab:selected {
    border-bottom: 0.35ex solid {{ palette('Selection') }};
}

/* Without its own image, macOS draws the selected tab's close glyph light, for its native dark
   selected tab: on the restyled base-coloured tab it vanished (QTBUG-61092). */
QTabBar::close-button {
    image: {{ icon('close') }};
    border-radius: 0.3ex;
}

QTabBar::close-button:hover {
    background: {{ palette('highlight') | alpha(30) }};
}
