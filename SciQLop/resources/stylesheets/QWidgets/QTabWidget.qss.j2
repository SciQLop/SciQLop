QTabWidget::pane {
    border-top: 1px solid {{ palette('border') }};
}

QTabWidget::tab-bar {
    left: 1ex;
}

QTabBar::tab {
    background: palette(base);
    min-width: 8ex;
    padding: 0.4ex 0.8ex;
    margin: 0 0.2ex;
    border: none;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: palette(base);
}

QTabBar::tab:selected {
    border-bottom: 0.2ex solid {{ palette('Selection') }};
}

QTabBar::tab:!selected {
    margin-top: 0.2ex;
    color: {{ palette('UnselectedText') }};
}

/* Without its own image, macOS draws the selected tab's close glyph light, for its native dark
   selected tab: on the restyled base-coloured tab it vanished (QTBUG-61092). */
QTabBar::close-button {
    image: {{ icon('close') }};
    border-radius: 0.3ex;
}

QTabBar::close-button:hover {
    background: {{ palette('highlight') | alpha(30) }};
}
