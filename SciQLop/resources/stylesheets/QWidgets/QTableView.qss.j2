QTableView {
    alternate-background-color: palette(alternate-base);
    show-decoration-selected: 1;
    gridline-color: {{ soft_border }};
    qproperty-showGrid: false;
}

QTableView::item {
    padding: 0 1ex;
    border-bottom: 1px solid {{ soft_border | over(palette('base'), 110) }};
}

QTableView QTableCornerButton::section {
    background: palette(base);
    border: none;
    border-bottom: 1px solid {{ soft_border }};
}

QTableView::item:hover {
    background: {{ hover_bg }};
}

QTableView::item:selected {
    border-bottom: 1px solid {{ soft_border | over(palette('base'), 110) }};
}

QTableView::item:selected:active {
    background: {{ selected_bg }};
    color: {{ palette('text') }};
}

QTableView::item:selected:!active {
    background: {{ unfocused_selected_bg }};
    color: {{ palette('text') }};
}

QHeaderView {
    background: palette(base);
    border: none;
}

QHeaderView::section {
    background: palette(base);
    color: {{ palette('UnselectedText') }};
    border: none;
    border-bottom: 1px solid {{ soft_border }};
    padding: 0.7ex 1ex;
    font-weight: normal;
}

QHeaderView::section:hover {
    color: palette(text);
}

QHeaderView::section:vertical {
    border: none;
    padding: 0 0.8ex;
}
