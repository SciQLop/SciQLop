
QToolButton {
    background-color: {{ control_bg }};
    color: palette(text);
    border: 1px solid {{ soft_border }};
    border-radius: {{ radius }};
    padding: 0 1.2ex;
    min-height: {{ controls_height }};
}

QToolButton:hover {
    background-color: {{ palette('highlight') | over(control_bg, 36) }};
    border: 1px solid {{ palette('Selection') | over(palette('base'), 150) }};
}

QToolButton:pressed {
    background-color: {{ palette('highlight') | over(control_bg, 70) }};
    border: 1px solid {{ palette('Selection') }};
}

QToolButton:disabled {
    color: {{ palette('UnselectedText') }};
    background-color: palette(window);
    border: 1px solid {{ soft_border | over(palette('base'), 128) }};
}

QToolButton::menu-indicator {
    image: {{ icon('arrow_drop_down') }};
    subcontrol-position: right center;
    subcontrol-origin: padding;
    width: 1.2ex;
    height: 1.2ex;
}

QToolButton[autoRaise="true"] {
    background-color: transparent;
    border: none;
    min-height: 0;
    padding: 0.2ex 0.6ex;
}

QToolButton[autoRaise="true"]:hover {
    background-color: {{ palette('highlight') | alpha(30) }};
    border: none;
    border-radius: {{ radius }};
}

QToolButton[autoRaise="true"]:pressed {
    background-color: {{ palette('highlight') | alpha(60) }};
    border: none;
}
