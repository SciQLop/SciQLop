# Pinned SciQLop launcher release, consumed by the installer build scripts the
# same way UV_VERSION and NODE_VERSION are. Bump the version and the matching
# digests together — fetch_launcher refuses to install an unverified binary.
#
# Digests come from the launcher-v<version> release assets (*.sha256). An
# all-zero digest means "not released yet" and makes the fetch skip (fatal on
# release builds).

LAUNCHER_VERSION=0.2.0
LAUNCHER_REPO=SciQLop/SciQLop

LAUNCHER_SHA256_linux_x86_64=1265ff730f9e4ecb52406fcf63f509c06e7290e5b215099d0faf7b0e3aa7455b
LAUNCHER_SHA256_macos_arm64=29b0f8f2e8beb9344544c8fe7803ef125a909900431099b9af8db1c8ce3f2937
LAUNCHER_SHA256_macos_x86_64=efc6022476fe4ab972cc4c0ccbaa033c891bd4142fabf71de7c675b52d8fe12e
LAUNCHER_SHA256_windows_x86_64=2c94ae1dae97adf4d4a0b430d01486ea598f34ad46e86fb8746d08b2ee08fd22
