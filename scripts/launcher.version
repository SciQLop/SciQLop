# Pinned SciQLop launcher release, consumed by the installer build scripts the
# same way UV_VERSION and NODE_VERSION are. Bump the version and the matching
# digests together — fetch_launcher refuses to install an unverified binary.
#
# Digests come from the launcher-v<version> release assets (*.sha256). An
# all-zero digest means "not released yet" and makes the fetch skip (fatal on
# release builds).

LAUNCHER_VERSION=0.1.3
LAUNCHER_REPO=SciQLop/SciQLop

LAUNCHER_SHA256_linux_x86_64=c8472cc9509f7374e37eebc701253a6366022bd3d48cd1ff08dbd704ba170849
LAUNCHER_SHA256_macos_arm64=d3640a80fdda74790148e26958e24a2000da2ebc53ed86f9870e97ca190cc439
LAUNCHER_SHA256_macos_x86_64=6248c631ab006cd3c7d3db56b2f3ded24bd67c8de90f724953dcb3d4c24079b1
LAUNCHER_SHA256_windows_x86_64=f3f597d9734ca5e86fe9c36ed3e1c480ac21a703a7621cac55036b152b2cb3bc
