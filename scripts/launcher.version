# Pinned SciQLop launcher release, consumed by the installer build scripts the
# same way UV_VERSION and NODE_VERSION are. Bump the version and the matching
# digests together — fetch_launcher refuses to install an unverified binary.
#
# Digests come from the launcher-v<version> release assets (*.sha256). An
# all-zero digest means "not released yet" and makes the fetch skip (fatal on
# release builds).

LAUNCHER_VERSION=0.1.1
LAUNCHER_REPO=SciQLop/SciQLop

LAUNCHER_SHA256_linux_x86_64=47897cfad87e21d78545730636a4e9c1baf9e8cc98d95c2e5aab2f39d922a529
LAUNCHER_SHA256_macos_arm64=ad284c94dc9f000809602d80fdc39c4b00ff43f4a6f80a100c1d298baa144e5b
LAUNCHER_SHA256_macos_x86_64=b0a5b23e39b249f85c38192f3c51b9eeaf991df1d9a43cae8f59d7c0ab4a8576
LAUNCHER_SHA256_windows_x86_64=a7d3d54863c6f5f5e585f2679a4526140ec7093ec267382bfeb35bd237848d21
