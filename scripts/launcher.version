# Pinned SciQLop launcher release, consumed by the installer build scripts the
# same way UV_VERSION and NODE_VERSION are. Bump the version and the matching
# digests together — fetch_launcher refuses to install an unverified binary.
#
# Digests come from the launcher-v<version> release assets (*.sha256). An
# all-zero digest means "not released yet" and makes the fetch skip (fatal on
# release builds).

LAUNCHER_VERSION=0.1.2
LAUNCHER_REPO=SciQLop/SciQLop

LAUNCHER_SHA256_linux_x86_64=67eae0960b537d44fd8cda76a3f85f099cbc83488e0e083cc45ffa9708cd0064
LAUNCHER_SHA256_macos_arm64=fcc67e34da106405008d9d4a79c7beb4eb3aeac895f4a6256e895255c26a0c3b
LAUNCHER_SHA256_macos_x86_64=bbbe6e328f855ebe7c1418fe36c051d57003a6fd7e4d8b7448eab261118f9677
LAUNCHER_SHA256_windows_x86_64=912c939284350e72a8b59d3b19c335e93310d222f7baf148d4bab04e3d53e90a
