# Pinned SciQLop launcher release, consumed by the installer build scripts the
# same way UV_VERSION and NODE_VERSION are. Bump the version and the matching
# digests together — fetch_launcher refuses to install an unverified binary.
#
# Digests come from the launcher-v<version> release assets (*.sha256). An
# all-zero digest means "not released yet" and makes the fetch skip (fatal on
# release builds).

LAUNCHER_VERSION=0.2.1
LAUNCHER_REPO=SciQLop/SciQLop

LAUNCHER_SHA256_linux_x86_64=fc1895c7d72ad744aea95dfe3718aecd70b59f4cd97dc62944317a6e6a599a25
LAUNCHER_SHA256_macos_arm64=ee24dcddfc1894f863a667f172fedbab814cca489e777ca599da96681ef838f5
LAUNCHER_SHA256_macos_x86_64=52501b95b8521323a556d9193b41f912634c46fab10bbf5b8c04833584f42939
LAUNCHER_SHA256_windows_x86_64=fc2e28628bfab9e2e2c555f453e29b47dba7f3a2fc752e98c9ec2d81096122d4
