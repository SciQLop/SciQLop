# Pinned SciQLop launcher release, consumed by the installer build scripts the
# same way UV_VERSION and NODE_VERSION are. Bump the version and the matching
# digests together — fetch_launcher refuses to install an unverified binary.
#
# Digests come from the launcher-v<version> release assets (*.sha256). An
# all-zero digest means "not released yet" and makes the fetch skip (fatal on
# release builds).

LAUNCHER_VERSION=0.2.2
LAUNCHER_REPO=SciQLop/SciQLop

LAUNCHER_SHA256_linux_x86_64=670bdcf91c61cf25a68e4e510d524af98a775aa28f87b9b3dd85d6a7029f674a
LAUNCHER_SHA256_macos_arm64=f5a618b071c7ac45a2d5c4079c84a30851b7065877d537b406580b17bbf57eb5
LAUNCHER_SHA256_macos_x86_64=a2c10ace705fd688a8b3dbcdc1687ae8a11a08cbeea5b3a5a4c7c50d5b1ad865
LAUNCHER_SHA256_windows_x86_64=e33b83717f51188dd8eb4fe756ba2d24a9b3f3797afc5099ab9a18bc82172e7a
